loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt cia402 count=3

addf lcec.read-all servo-thread
addf cia402.0.read-all servo-thread
addf cia402.1.read-all servo-thread
addf cia402.2.read-all servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf lcec.write-all servo-thread
addf cia402.0.write-all servo-thread
addf cia402.1.write-all servo-thread
addf cia402.2.write-all servo-thread

#*************************
#  AXIS X
#*************************

setp cia402.0.csp-mode 1
setp cia402.0.pos-scale 655360
setp cia402.0.velo-scale 655360

net x-pos-cmd <= joint.0.motor-pos-cmd
net x-pos-fb  <= joint.0.motor-pos-fb
net x-enable  <= joint.0.amp-enable-out
#net x-vel-cmd <= joint.0.vel-cmd

net x-enable  => cia402.0.enable
net x-pos-cmd => cia402.0.pos-cmd
net x-pos-fb  => cia402.0.pos-fb
net x-amp-fault => joint.0.amp-fault-in <= cia402.0.drv-fault

net x-status-word lcec.0.x-servo.status-word => cia402.0.statusword
net x-drv-act-pos lcec.0.x-servo.position-actual => cia402.0.drv-actual-position
net x-opmode-display lcec.0.x-servo.mode-display => cia402.0.opmode-display

net x-controlword cia402.0.controlword => lcec.0.x-servo.control-word
net x-drv-target-pos cia402.0.drv-target-position => lcec.0.x-servo.target-position
net x-modes-of-operation cia402.0.opmode => lcec.0.x-servo.control-mode

# Drive-native CiA402 homing, triggered via stock LinuxCNC's own index-pulse homing
# path (HOME_USE_INDEX=YES in the INI) instead of a custom homing module. Homing
# method, speeds and accel are pushed into the drive's own object dictionary every
# EtherCAT start via these RPDOs. cia402.0.home is wired straight to joint.0.index-
# enable: homing.c sets that pin true to request a search and waits for it to clear;
# cia402.comp treats "true" as "start the drive's internal homing move" and clears
# the pin itself once the drive reports done, which homing.c then reads as "index
# pulse arrived" -- no custom HAL component needed for the trigger.
setp lcec.0.x-servo.home-offset [JOINT_0]CIA402_HOME_OFFSET_COUNTS
setp lcec.0.x-servo.homing-method [JOINT_0]CIA402_HOMING_METHOD
setp lcec.0.x-servo.homing-high-velocity [JOINT_0]CIA402_HOMING_SEARCH_VELOCITY
setp lcec.0.x-servo.homing-low-velocity [JOINT_0]CIA402_HOMING_LATCH_VELOCITY
setp lcec.0.x-servo.homing-acceleration [JOINT_0]CIA402_HOMING_ACCELERATION
net x-index-enable joint.0.index-enable cia402.0.home

#
#  AXIS Y
#

setp cia402.1.csp-mode 1
setp cia402.1.pos-scale 655360
setp cia402.1.velo-scale 655360

net y-pos-cmd <= joint.1.motor-pos-cmd
net y-pos-fb  <= joint.1.motor-pos-fb
net y-enable  <= joint.1.amp-enable-out

net y-enable  => cia402.1.enable
net y-pos-cmd => cia402.1.pos-cmd
net y-pos-fb  => cia402.1.pos-fb
net y-amp-fault => joint.1.amp-fault-in <= cia402.1.drv-fault

net y-status-word lcec.0.y-servo.status-word => cia402.1.statusword
net y-drv-act-pos lcec.0.y-servo.position-actual => cia402.1.drv-actual-position
net y-opmode-display lcec.0.y-servo.mode-display => cia402.1.opmode-display

net y-controlword cia402.1.controlword => lcec.0.y-servo.control-word
net y-drv-target-pos cia402.1.drv-target-position => lcec.0.y-servo.target-position
net y-modes-of-operation cia402.1.opmode => lcec.0.y-servo.control-mode

setp lcec.0.y-servo.home-offset [JOINT_1]CIA402_HOME_OFFSET_COUNTS
setp lcec.0.y-servo.homing-method [JOINT_1]CIA402_HOMING_METHOD
setp lcec.0.y-servo.homing-high-velocity [JOINT_1]CIA402_HOMING_SEARCH_VELOCITY
setp lcec.0.y-servo.homing-low-velocity [JOINT_1]CIA402_HOMING_LATCH_VELOCITY
setp lcec.0.y-servo.homing-acceleration [JOINT_1]CIA402_HOMING_ACCELERATION
net y-index-enable joint.1.index-enable cia402.1.home

#
#  AXIS Z
#
setp cia402.2.csp-mode 1
setp cia402.2.pos-scale 655360
setp cia402.2.velo-scale 655360

net z-pos-cmd <= joint.2.motor-pos-cmd
net z-pos-fb  <= joint.2.motor-pos-fb
net z-enable  <= joint.2.amp-enable-out

net z-enable  => cia402.2.enable
net z-pos-cmd => cia402.2.pos-cmd
net z-pos-fb  => cia402.2.pos-fb
net z-amp-fault => joint.2.amp-fault-in <= cia402.2.drv-fault

net z-status-word lcec.0.z-servo.status-word => cia402.2.statusword
net z-drv-act-pos lcec.0.z-servo.position-actual => cia402.2.drv-actual-position
net z-opmode-display lcec.0.z-servo.mode-display => cia402.2.opmode-display

net z-controlword cia402.2.controlword => lcec.0.z-servo.control-word
net z-drv-target-pos cia402.2.drv-target-position => lcec.0.z-servo.target-position
net z-modes-of-operation cia402.2.opmode => lcec.0.z-servo.control-mode

setp lcec.0.z-servo.home-offset [JOINT_2]CIA402_HOME_OFFSET_COUNTS
setp lcec.0.z-servo.homing-method [JOINT_2]CIA402_HOMING_METHOD
setp lcec.0.z-servo.homing-high-velocity [JOINT_2]CIA402_HOMING_SEARCH_VELOCITY
setp lcec.0.z-servo.homing-low-velocity [JOINT_2]CIA402_HOMING_LATCH_VELOCITY
setp lcec.0.z-servo.homing-acceleration [JOINT_2]CIA402_HOMING_ACCELERATION
net z-index-enable joint.2.index-enable cia402.2.home

net atc-down-switch lcec.0.EL1008-digital-in-1.din-0
net atc-up-switch lcec.0.EL1008-digital-in-1.din-1
net atc-in-switch lcec.0.EL1008-digital-in-1.din-2
net atc-out-switch lcec.0.EL1008-digital-in-1.din-3

#net platter-down-button lcec.0.EL1008-digital-in-1.din-4-not
net platter-index-button lcec.0.EL1008-digital-in-1.din-5-not
#net drawbar-release-button lcec.0.EL1008-digital-in-1.din-6-not

net atc-down-solenoid lcec.0.EL2008-digital-out-1.dout-1 lcec.0.EL1008-digital-in-1.din-4-not
net atc-in-solenoid lcec.0.EL2008-digital-out-1.dout-2
net spindle-clamp-solenoid lcec.0.EL2008-digital-out-1.dout-4 lcec.0.EL1008-digital-in-1.din-6-not

setp iocontrol.0.emc-enable-in 1
